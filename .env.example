# Connector mode: mock | live
SIGNALROOM_CONNECTOR_MODE=mock

# Base URL of your reporting ingestion API (optional when mode=live)
# Example: https://api.your-domain.com
SIGNALROOM_DATA_API_BASE_URL=

# Optional bearer token sent to the ingestion API
SIGNALROOM_DATA_API_KEY=

# Timeout in milliseconds for connector API requests
SIGNALROOM_CONNECTOR_TIMEOUT_MS=8000

# -----------------------------
# Direct BigQuery connector mode
# -----------------------------
# If SIGNALROOM_CONNECTOR_MODE=live and SIGNALROOM_DATA_API_BASE_URL is empty,
# Signal Room can query BigQuery directly when one of these is set:
# - SIGNALROOM_BQ_SNAPSHOT_QUERY
# - SIGNALROOM_BQ_SNAPSHOTS_TABLE

# Optional explicit project and location (defaults to EU location)
SIGNALROOM_BIGQUERY_PROJECT_ID=
SIGNALROOM_BIGQUERY_LOCATION=EU

# Option A: table with latest snapshot rows
# Format: project.dataset.table
SIGNALROOM_BQ_SNAPSHOTS_TABLE=

# Option B: full custom SQL query using @clientId and @source parameters
SIGNALROOM_BQ_SNAPSHOT_QUERY=

# Optional inline service account credentials (alternative to GOOGLE_APPLICATION_CREDENTIALS)
SIGNALROOM_BIGQUERY_CLIENT_EMAIL=
SIGNALROOM_BIGQUERY_PRIVATE_KEY=
